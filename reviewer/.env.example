# OpenRouter key used by the reviewer and by promptfoo evals
LLM_PROVIDER_API_KEY=
OPENROUTER_API_KEY=
# cheapest model with structured output that still reviews sensibly; override per run
REVIEW_MODEL=deepseek/deepseek-v4.1-flash
# cost guard: diffs longer than this (chars) are truncated before they reach the model
DIFF_MAX_CHARS=120000
