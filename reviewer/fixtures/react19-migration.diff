+export function UserCard({ userId, compact, onResize }: Props) {
+  const [user, setUser] = useState<User | null>(null);
+  const [seconds, setSeconds] = useState(0);
+
+  useEffect(() => {
+    fetchUser(userId).then(setUser);
+  }, []);
+
+  useEffect(() => {
+    const handleResize = () => onResize?.(window.innerWidth);
+    window.addEventListener("resize", handleResize);
+  }, [onResize]);
+
+  useEffect(() => {
+    const timer = window.setInterval(() => setSeconds(seconds + 1), 1000);
+    return () => window.clearInterval(timer);
+  }, []);
+
+  if (!user) return <p>Loading…</p>;
+  return (
+    <article className={compact ? "card card--compact" : "card"}>
+      <h2>{user.name}</h2>
+      <p>Visible for {seconds}s</p>
+    </article>
+  );
+}
+
