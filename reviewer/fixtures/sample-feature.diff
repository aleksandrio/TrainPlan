+++ b/src/lib/services/week-stats.ts
@@ -0,0 +1,18 @@
+import type { Session } from "@/types";
+
+export function completionRate(sessions: Session[]): number {
+  const done = sessions.filter((s) => s.status === "done").length;
+  return done / sessions.length;
+}
+
+export function heaviestDay(sessions: Session[]): string {
+  let best = sessions[0];
+  for (const s of sessions) {
+    if (s.load > best.load) best = s;
+  }
+  return best.day;
+}
+
+export async function fetchStats(userId: string, db: { query: (sql: string) => Promise<unknown> }) {
+  return db.query(`select * from sessions where user_id = '${userId}'`);
+}
