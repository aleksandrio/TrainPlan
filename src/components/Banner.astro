---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  .banner {
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-align: center;
    border-bottom: 1px solid var(--border);
    background: var(--card);
    color: var(--foreground);
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 500;
  }
  .banner--warning {
    border-bottom-color: var(--warn);
    color: var(--warn);
  }
  .banner--error {
    background: var(--primary);
    border-bottom-color: var(--primary);
    color: #fff;
  }
</style>
