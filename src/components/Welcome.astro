---
import Topbar from "@/components/Topbar.astro";

const steps = [
  {
    label: "01 · Tell",
    title: "One form",
    text: "Goal, level, available days, fixed commitment. Under two minutes, once.",
  },
  {
    label: "02 · Check",
    title: "Three rules",
    text: "48 h between heavy sessions on the same muscles, a weekly load cap for your level, a light day before your fixed activity.",
  },
  {
    label: "03 · Adapt",
    title: "Skip, re-plan",
    text: "Mark a session skipped and see exactly what moves, what drops and why. Accept it or keep the plan.",
  },
];
---

<div class="flex min-h-screen w-full flex-col bg-background text-foreground">
  <div class="label bg-primary px-3 py-1.5 text-center text-white">
    Weekly training planner · one form, one click, one valid week
  </div>
  <Topbar />

  <section class="bg-grid relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse at center, rgb(5 5 5 / 0) 15%, var(--background) 75%);"
    ></div>
    <div class="relative mx-auto flex max-w-3xl flex-col items-center gap-7 px-4 py-20 text-center sm:py-28 lg:py-36">
      <span class="label text-accent-ink">Built for people who train after work</span>
      <h1 class="max-w-[14ch] text-5xl sm:text-6xl lg:text-7xl">One goal in. A week that holds.</h1>
      <p class="max-w-[46ch] text-base text-muted-foreground sm:text-lg">
        Describe what you train for, which days you have and your fixed activity. TrainPlan drafts the week, checks
        regeneration and load for you, and re-plans the rest when you skip a session.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href="/auth/signup"
          class="inline-flex items-center justify-center border border-primary bg-primary px-6 py-3 text-sm font-medium text-white transition-opacity hover:opacity-90"
        >
          Plan my week
        </a>
        <a
          href="/auth/signin"
          class="inline-flex items-center justify-center border border-foreground px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-secondary"
        >
          Sign in
        </a>
      </div>
      <span class="label text-muted-foreground">No wearables · no logging · just the decision layer</span>
    </div>
  </section>

  <section class="grid border-t border-border sm:grid-cols-3">
    {steps.map((s, i) => (
      <div
        class:list={[
          "flex flex-col gap-2 px-5 py-6 sm:px-6",
          i < steps.length - 1 && "border-b border-border sm:border-r sm:border-b-0",
        ]}
      >
        <span class="label text-accent-ink">{s.label}</span>
        <h2 class="text-2xl">{s.title}</h2>
        <p class="text-sm text-muted-foreground">{s.text}</p>
      </div>
    ))}
  </section>

  <footer class="label mt-auto border-t border-border px-4 py-3 text-muted-foreground sm:px-6">
    TrainPlan · Astro + Supabase + Cloudflare
  </footer>
</div>
