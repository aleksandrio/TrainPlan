---
import Layout from "@/layouts/Layout.astro";

interface Props {
  title: string;
  active?: "week" | "goal" | "history";
}

const { title, active } = Astro.props;
const { user } = Astro.locals;
const link = (key: string) =>
  `rounded-md px-3 py-1.5 text-sm transition-colors ${
    active === key ? "bg-white/15 text-white" : "text-blue-100/70 hover:bg-white/10 hover:text-white"
  }`;
---

<Layout title={`${title} · TrainPlan`}>
  <div class="bg-cosmic min-h-screen w-full text-white">
    <div class="mx-auto max-w-6xl p-4 sm:p-6">
      <header class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-2 backdrop-blur">
        <a
          href="/app"
          class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-lg font-bold text-transparent"
        >
          TrainPlan
        </a>
        <nav class="flex items-center gap-1" aria-label="Main">
          <a href="/app" class:list={link("week")}>
            Week
          </a>
          <a href="/app/goal" class:list={link("goal")}>
            Goal
          </a>
          <a href="/app/history" class:list={link("history")}>
            History
          </a>
        </nav>
        <div class="flex items-center gap-3 text-sm">
          <span class="hidden text-blue-100/60 sm:inline" data-testid="user-email">
            {user?.email}
          </span>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </div>
</Layout>
