---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";

interface Props {
  title: string;
  active?: "week" | "goal" | "history";
}

const { title, active } = Astro.props;
---

<Layout title={`${title} · TrainPlan`}>
  <div class="flex min-h-screen w-full flex-col bg-background text-foreground">
    <Topbar active={active} />
    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6 sm:py-8">
      <slot />
    </main>
    <footer class="label border-t border-border px-4 py-3 text-muted-foreground sm:px-6">
      TrainPlan · one form, one click, one valid week
    </footer>
  </div>
</Layout>
