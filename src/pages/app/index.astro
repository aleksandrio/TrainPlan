---
import AppLayout from "@/layouts/AppLayout.astro";
import WeekPlanner from "@/components/plan/WeekPlanner";
import { loadWeek } from "@/lib/services/week";

const { supabase, user } = Astro.locals;
const state = supabase && user ? await loadWeek(supabase, user.id) : null;
---

<AppLayout title="Your week" active="week">
  {state?.goal ? (
    <WeekPlanner
      goal={state.goal}
      plan={state.plan}
      validation={state.validation}
      weekStart={state.weekStart}
      today={state.today}
      client:load
    />
  ) : (
    <section class="corner-marks mx-auto max-w-xl border border-dashed border-line-strong px-6 py-12 text-center">
      <span class="label text-accent-ink">Step 1</span>
      <h1 class="mt-3 mb-3 text-4xl">Start with your goal</h1>
      <p class="mx-auto mb-8 max-w-[38ch] text-muted-foreground">
        Tell TrainPlan what you train for, which days you have and your fixed activity. One form, then one click.
      </p>
      <a
        href="/app/goal"
        class="inline-flex items-center border border-primary bg-primary px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
        data-testid="set-goal-link"
      >
        Set my goal
      </a>
    </section>
  )}
</AppLayout>
