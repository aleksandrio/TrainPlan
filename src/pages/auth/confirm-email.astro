---
import AuthLayout from "@/layouts/AuthLayout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      eyebrow: "Done",
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      eyebrow: "One more step",
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<AuthLayout title={content.heading} eyebrow={content.eyebrow}>
  <span class="label text-accent-ink">{content.eyebrow}</span>
  <h1 class="mt-2 mb-4 text-4xl">{content.heading}</h1>
  <p class="mb-8 text-ink-body">{content.description}</p>
  <a
    href="/auth/signin"
    class="inline-flex items-center justify-center border border-foreground px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-secondary"
  >
    {content.linkText}
  </a>
</AuthLayout>
