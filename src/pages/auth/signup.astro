---
import AuthLayout from "@/layouts/AuthLayout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<AuthLayout title="Create account" eyebrow="New account">
  <h1 class="mb-6 text-4xl">Create account</h1>
  <SignUpForm serverError={error} client:load />
  <p class="label mt-6 text-muted-foreground">
    Already have an account?{" "}
    <a href="/auth/signin" class="text-foreground underline-offset-4 hover:underline">
      Sign in
    </a>
  </p>
</AuthLayout>
