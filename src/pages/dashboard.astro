---
import AppLayout from "@/layouts/AppLayout.astro";

const { user } = Astro.locals;
---

<AppLayout title="Account">
  <section class="corner-marks mx-auto max-w-xl border border-border">
    <div class="label flex items-center justify-between border-b border-border px-5 py-2.5 text-muted-foreground">
      <span class="text-accent-ink">Account</span>
      <span>Signed in</span>
    </div>
    <div class="flex flex-col gap-4 px-5 py-8">
      <h1 class="text-4xl">Welcome back.</h1>
      <p class="text-ink-body">
        Signed in as <span class="font-mono text-sm text-foreground">{user?.email}</span>
      </p>
      <div class="mt-2 flex flex-wrap gap-3">
        <a
          href="/app"
          class="inline-flex items-center border border-primary bg-primary px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90"
        >
          Go to your week
        </a>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="inline-flex items-center border border-line-strong px-4 py-2 text-sm text-foreground transition-colors hover:bg-secondary"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>
  </section>
</AppLayout>
